# ==============================================================================
# BPUT DIGITAL CAMPUS PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure with institutional credentials. NEVER commit .env.
# ==============================================================================

# Server Runtime & Port
PORT=5000
NODE_ENV=production
DEBUG=false

# Security & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://campus.bput.ac.in
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Supabase Realtime Database (Optional Cloud Sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_TABLE=students

# Clerk Single Sign-On (Optional Federated SSO)
BPUT_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key

# Sentry Observability & Error Tracking
BPUT_SENTRY_DSN=
